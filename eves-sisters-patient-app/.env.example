# Eve's Sisters patient app — public configuration.
#
# EXPO_PUBLIC_* values are compiled into the app binary and can be read by
# anyone who has it. NEVER put API keys, client secrets or tokens here.

# "mock" (default) or "hosted-portal". There is no "live" mode until Karpa
# Health documents and authorizes an integration.
EXPO_PUBLIC_INTEGRATION_MODE=mock

# Hosted-portal URLs (HTTPS only). Leave blank until each URL is confirmed in
# writing AND its host is added to APPROVED_PORTAL_HOSTS in
# src/integrations/karpa/index.ts.
EXPO_PUBLIC_PORTAL_INTAKE_URL=
EXPO_PUBLIC_PORTAL_SCHEDULING_URL=
EXPO_PUBLIC_PORTAL_VIDEO_URL=
EXPO_PUBLIC_PORTAL_MESSAGES_URL=
EXPO_PUBLIC_PORTAL_BILLING_URL=
EXPO_PUBLIC_PORTAL_RECORDS_URL=
