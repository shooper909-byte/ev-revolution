# Public site URL, used for sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://evevolutionhealth.com

# Where newsletter signups are forwarded (e.g. a Klaviyo/Mailchimp/Zapier
# webhook). Until this is set, /api/subscribe returns a clear "not connected"
# message instead of silently accepting addresses.
EV_NEWSLETTER_WEBHOOK_URL=

# Where contact form submissions are forwarded. Same behaviour as above.
EV_CONTACT_WEBHOOK_URL=

# Where care assessment leads (/care/weight-management and
# /care/hormones-menopause) are forwarded. Must be https://.
# Falls back to EV_CONTACT_WEBHOOK_URL when unset.
EV_CARE_LEAD_WEBHOOK_URL=

# Comma-separated two-letter state codes where weight-care service has been
# verified. Every other state is presented and submitted as waitlist-only.
EV_WEIGHT_CARE_STATES=

# ---------------------------------------------------------------------------
# Brevo — email capture (footer, journal, site-wide popup)
#
# With BREVO_API_KEY set, /api/subscribe writes contacts straight to Brevo and
# the webhook above is not used. Run `npm run brevo:setup` once with the key to
# create the lists and attributes, then paste the values it prints below.
# ---------------------------------------------------------------------------

# v3 API key from https://app.brevo.com/settings/keys/api. Server-side only —
# never prefix this with NEXT_PUBLIC_.
BREVO_API_KEY=

# Default list every capture joins.
BREVO_LIST_ID=

# Optional per-source overrides. Anything unset falls back to BREVO_LIST_ID.
# Sources: FOOTER, JOURNAL, POPUP, SITE. Comma-separate to join several lists.
BREVO_LIST_ID_POPUP=

# Optional custom attributes stamped on each contact. Both must already exist
# in Brevo (npm run brevo:setup creates them). Leave unset to send only the
# built-in fields — a missing attribute never costs you the subscriber.
BREVO_SOURCE_ATTRIBUTE=
BREVO_CONSENT_ATTRIBUTE=

# Used by `npm run brevo:setup` only — the running app never reads these.
# The address campaigns send from, and the name recipients see. The script
# creates the sender in Brevo, which emails it a verification link, and adds
# its domain for authentication, printing the DNS records to add.
BREVO_SENDER_EMAIL=customerservice@evevolutionhealth.com
BREVO_SENDER_NAME=Eve's Sisters

# Optional double opt-in. Set both to send a confirmation email instead of
# subscribing immediately: the ID of a Brevo double opt-in template, and the
# https:// page Brevo returns the visitor to after they confirm.
BREVO_DOI_TEMPLATE_ID=
BREVO_DOI_REDIRECT_URL=
